# Supabase (PostgreSQL). Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos
# (si tiene caracteres especiales como @ : / # ? %, codifícalos en URL, p. ej. @ -> %40).

# Pooler en modo transacción (IPv4): lo usa la aplicación.
DATABASE_URL="postgresql://postgres.gitspgpfwsbchlaxwcnw:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Pooler en modo sesión: se usa para crear/migrar las tablas (init_db).
DIRECT_URL="postgresql://postgres.gitspgpfwsbchlaxwcnw:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Clave para firmar (HMAC) los tokens que viajan dentro de cada QR de Modo AR.
# Cambiar por un valor propio y secreto en producción.
AR_SIGNING_SECRET=cambia-esto-en-produccion
